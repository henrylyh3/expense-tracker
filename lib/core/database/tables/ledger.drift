-- Source of truth for schema v4; also executable by SQLite for independent QA.
CREATE TABLE categories (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) BETWEEN 1 AND 64),
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 80),
  type TEXT NOT NULL CHECK (type IN ('income', 'expense')),
  icon_key TEXT NOT NULL CHECK (length(icon_key) BETWEEN 1 AND 64),
  color_hex TEXT NOT NULL CHECK (
    length(color_hex) = 7 AND substr(color_hex, 1, 1) = '#'
    AND substr(color_hex, 2) NOT GLOB '*[^0-9A-Fa-f]*'
  ),
  sort_order INTEGER NOT NULL DEFAULT 0 CHECK (typeof(sort_order) = 'integer' AND sort_order >= 0),
  is_archived BOOLEAN NOT NULL DEFAULT FALSE CHECK (is_archived IN (0, 1))
);

CREATE TABLE currencies (
  code TEXT NOT NULL PRIMARY KEY CHECK (
    length(code) = 3 AND code NOT GLOB '*[^A-Z]*'
  ),
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 80),
  symbol TEXT NOT NULL CHECK (length(trim(symbol)) BETWEEN 1 AND 12),
  decimal_places INTEGER NOT NULL CHECK (typeof(decimal_places) = 'integer' AND decimal_places BETWEEN 0 AND 6),
  rate_to_myr TEXT NOT NULL CHECK (
    length(rate_to_myr) BETWEEN 1 AND 25
    AND rate_to_myr NOT GLOB '*[^0-9.]*'
    AND rate_to_myr GLOB '*[1-9]*'
    AND substr(rate_to_myr, 1, 1) <> '.'
    AND substr(rate_to_myr, -1) <> '.'
    AND (length(rate_to_myr) = 1 OR substr(rate_to_myr, 1, 1) <> '0'
         OR substr(rate_to_myr, 2, 1) = '.')
    AND (instr(rate_to_myr, '.') = 0 AND length(rate_to_myr) <= 12
      OR instr(rate_to_myr, '.') BETWEEN 2 AND 13
         AND length(rate_to_myr) - instr(rate_to_myr, '.') BETWEEN 1 AND 12
         AND substr(rate_to_myr, instr(rate_to_myr, '.') + 1) NOT GLOB '*.*')
  ),
  is_active BOOLEAN NOT NULL DEFAULT TRUE CHECK (is_active IN (0, 1)),
  created_at_utc INTEGER NOT NULL CHECK (typeof(created_at_utc) = 'integer' AND created_at_utc >= 0),
  updated_at_utc INTEGER NOT NULL CHECK (typeof(updated_at_utc) = 'integer' AND updated_at_utc >= created_at_utc),
  CHECK (code <> 'MYR' OR
    (decimal_places = 2 AND rate_to_myr = '1' AND is_active = 1))
);

CREATE TABLE trips (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) BETWEEN 1 AND 64),
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 80)
);

CREATE TABLE currency_rates (
  id TEXT NOT NULL PRIMARY KEY CHECK (length(id) BETWEEN 1 AND 80),
  currency_code TEXT NOT NULL REFERENCES currencies(code) ON DELETE RESTRICT ON UPDATE CASCADE,
  name TEXT NOT NULL CHECK (length(trim(name)) BETWEEN 1 AND 80),
  rate_to_myr TEXT NOT NULL CHECK (
    length(rate_to_myr) BETWEEN 1 AND 25
    AND rate_to_myr NOT GLOB '*[^0-9.]*'
    AND rate_to_myr GLOB '*[1-9]*'
    AND substr(rate_to_myr, 1, 1) <> '.'
    AND substr(rate_to_myr, -1) <> '.'
    AND (length(rate_to_myr) = 1 OR substr(rate_to_myr, 1, 1) <> '0'
         OR substr(rate_to_myr, 2, 1) = '.')
    AND (instr(rate_to_myr, '.') = 0 AND length(rate_to_myr) <= 12
      OR instr(rate_to_myr, '.') BETWEEN 2 AND 13
         AND length(rate_to_myr) - instr(rate_to_myr, '.') BETWEEN 1 AND 12
         AND substr(rate_to_myr, instr(rate_to_myr, '.') + 1) NOT GLOB '*.*')
  ),
  is_active BOOLEAN NOT NULL DEFAULT TRUE CHECK (is_active IN (0, 1)),
  CHECK (currency_code <> 'MYR')
);

CREATE TABLE trip_rates (
  trip_id TEXT NOT NULL REFERENCES trips(id) ON DELETE CASCADE,
  currency_code TEXT NOT NULL REFERENCES currencies(code) ON DELETE CASCADE ON UPDATE CASCADE,
  rate_to_myr TEXT NOT NULL CHECK (
    length(rate_to_myr) BETWEEN 1 AND 25
    AND rate_to_myr NOT GLOB '*[^0-9.]*'
    AND rate_to_myr GLOB '*[1-9]*'
    AND substr(rate_to_myr, 1, 1) <> '.'
    AND substr(rate_to_myr, -1) <> '.'
    AND (length(rate_to_myr) = 1 OR substr(rate_to_myr, 1, 1) <> '0'
         OR substr(rate_to_myr, 2, 1) = '.')
    AND (instr(rate_to_myr, '.') = 0 AND length(rate_to_myr) <= 12
      OR instr(rate_to_myr, '.') BETWEEN 2 AND 13
         AND length(rate_to_myr) - instr(rate_to_myr, '.') BETWEEN 1 AND 12
         AND substr(rate_to_myr, instr(rate_to_myr, '.') + 1) NOT GLOB '*.*')
  ),
  name TEXT CHECK (name IS NULL OR length(trim(name)) BETWEEN 1 AND 80),
  rate_id TEXT REFERENCES currency_rates(id) ON DELETE RESTRICT,
  PRIMARY KEY (trip_id, currency_code),
  CHECK (currency_code <> 'MYR')
);

CREATE TABLE transactions (
  id TEXT NOT NULL PRIMARY KEY CHECK (
    length(id) = 36 AND substr(id, 9, 1) = '-'
    AND substr(id, 14, 1) = '-' AND substr(id, 19, 1) = '-'
    AND substr(id, 24, 1) = '-'
    AND length("replace"(id, '-', '')) = 32
    AND "replace"(id, '-', '') NOT GLOB '*[^0-9A-Fa-f]*'
  ),
  category_id TEXT NOT NULL REFERENCES categories(id) ON DELETE RESTRICT ON UPDATE RESTRICT,
  type TEXT NOT NULL CHECK (type IN ('income', 'expense')),
  amount_minor INTEGER NOT NULL CHECK (typeof(amount_minor) = 'integer' AND amount_minor > 0),
  currency_code TEXT NOT NULL REFERENCES currencies(code) ON DELETE RESTRICT ON UPDATE RESTRICT,
  exchange_rate_snapshot TEXT NOT NULL CHECK (
    length(exchange_rate_snapshot) BETWEEN 1 AND 25
    AND exchange_rate_snapshot NOT GLOB '*[^0-9.]*'
    AND exchange_rate_snapshot GLOB '*[1-9]*'
    AND substr(exchange_rate_snapshot, 1, 1) <> '.'
    AND substr(exchange_rate_snapshot, -1) <> '.'
    AND (length(exchange_rate_snapshot) = 1 OR substr(exchange_rate_snapshot, 1, 1) <> '0'
         OR substr(exchange_rate_snapshot, 2, 1) = '.')
    AND (instr(exchange_rate_snapshot, '.') = 0 AND length(exchange_rate_snapshot) <= 12
      OR instr(exchange_rate_snapshot, '.') BETWEEN 2 AND 13
         AND length(exchange_rate_snapshot) - instr(exchange_rate_snapshot, '.') BETWEEN 1 AND 12
         AND substr(exchange_rate_snapshot, instr(exchange_rate_snapshot, '.') + 1) NOT GLOB '*.*')
  ),
  amount_myr_minor INTEGER NOT NULL CHECK (
    typeof(amount_myr_minor) = 'integer' AND amount_myr_minor >= 0
  ),
  transaction_date TEXT NOT NULL CHECK (
    transaction_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
    AND transaction_date BETWEEN '0001-01-01' AND '9999-12-31'
    AND date(transaction_date, '+0 days') IS NOT NULL
    AND date(transaction_date, '+0 days') = transaction_date
  ),
  note TEXT CHECK (note IS NULL OR length(note) <= 2000),
  created_at_utc INTEGER NOT NULL CHECK (typeof(created_at_utc) = 'integer' AND created_at_utc >= 0),
  updated_at_utc INTEGER NOT NULL CHECK (typeof(updated_at_utc) = 'integer' AND updated_at_utc >= created_at_utc),
  trip_id TEXT NOT NULL DEFAULT 'personal' REFERENCES trips(id),
  CHECK (currency_code <> 'MYR' OR
    (exchange_rate_snapshot = '1' AND amount_myr_minor = amount_minor))
);

CREATE TABLE app_settings (
  "key" TEXT NOT NULL PRIMARY KEY CHECK (length("key") BETWEEN 1 AND 80),
  value TEXT NOT NULL CHECK (length(value) <= 4000)
);

CREATE INDEX transactions_trip_date_idx ON transactions(trip_id, transaction_date DESC, id);
CREATE INDEX transactions_date_idx ON transactions(transaction_date DESC, id);
CREATE INDEX transactions_category_date_idx ON transactions(category_id, transaction_date);
CREATE INDEX transactions_currency_date_idx ON transactions(currency_code, transaction_date);
CREATE INDEX transactions_type_date_idx ON transactions(type, transaction_date);

-- The repository archives referenced parents when the user requests deletion.
CREATE TRIGGER protect_myr_delete BEFORE DELETE ON currencies
WHEN OLD.code = 'MYR'
BEGIN
  SELECT RAISE(ABORT, 'MYR cannot be deleted');
END;

CREATE TRIGGER protect_myr_code BEFORE UPDATE OF code ON currencies
WHEN OLD.code = 'MYR' AND NEW.code <> OLD.code
BEGIN
  SELECT RAISE(ABORT, 'MYR code cannot change');
END;

CREATE TRIGGER protect_used_currency BEFORE UPDATE OF code, decimal_places ON currencies
WHEN (NEW.code <> OLD.code OR NEW.decimal_places <> OLD.decimal_places)
  AND EXISTS (SELECT 1 FROM transactions WHERE currency_code = OLD.code)
BEGIN
  SELECT RAISE(ABORT, 'Used currency code and precision cannot change');
END;

CREATE TRIGGER protect_used_category_type BEFORE UPDATE OF type ON categories
WHEN NEW.type <> OLD.type
  AND EXISTS (SELECT 1 FROM transactions WHERE category_id = OLD.id)
BEGIN
  SELECT RAISE(ABORT, 'Used category type cannot change');
END;

-- Active-reference selection belongs in repositories. Restore must accept
-- historical rows referencing archived parents, while still enforcing type.
CREATE TRIGGER validate_transaction_insert BEFORE INSERT ON transactions
WHEN NOT EXISTS (
  SELECT 1 FROM categories WHERE id = NEW.category_id AND type = NEW.type
)
BEGIN
  SELECT RAISE(ABORT, 'Transaction category must match its type');
END;

CREATE TRIGGER validate_transaction_update BEFORE UPDATE OF category_id, type ON transactions
WHEN NOT EXISTS (
  SELECT 1 FROM categories WHERE id = NEW.category_id AND type = NEW.type
)
BEGIN
  SELECT RAISE(ABORT, 'Transaction category must match its type');
END;
